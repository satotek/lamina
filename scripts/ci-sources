#!/usr/bin/env python3
"""Align source mtimes with a `target/` directory restored from a CI cache.

Cargo decides whether a package is stale by comparing the mtime of its sources
with the fingerprints it recorded in `target/`. CI restores `target/` from an
earlier run, but the checkout that precedes the restore writes every file with
the current time, so every crate looks modified and the cached artifacts are
thrown away. Rewriting the timestamps is what makes the cache pay off.

`record` stores a content hash of every tracked file inside `target/`, so the
manifest travels with the cache it describes. `restore` rewinds the mtime of
each file whose content still matches the manifest to a fixed timestamp that
predates any cached artifact, and leaves changed or newly added files with
their checkout mtime; cargo then rebuilds exactly the crates whose sources
moved, plus their dependents.

Hashing content rather than trusting mtimes keeps the decision correct across
machines and checkouts that rewrite line endings, where equal timestamps say
nothing about equal files.

Usage: scripts/ci-sources {record|restore}
"""

import hashlib
import json
import os
import subprocess
import sys

MANIFEST_NAME = "ci-sources.json"
MANIFEST_VERSION = 1
# 2000-01-01T00:00:00Z. Any cached artifact and any checkout is newer, so a
# restored source can never look modified by accident.
FIXED_MTIME = 946684800
CHUNK_SIZE = 1 << 20


def manifest_path() -> str:
    # CI builds into ./target, but a local run may point CARGO_TARGET_DIR
    # elsewhere; follow whichever directory cargo actually uses.
    target_dir = os.environ.get("CARGO_TARGET_DIR") or "target"
    return os.path.join(target_dir, MANIFEST_NAME)


def tracked_files() -> list[bytes]:
    try:
        output = subprocess.run(
            ["git", "ls-files", "-z"],
            check=True,
            stdout=subprocess.PIPE,
        ).stdout
    except (OSError, subprocess.CalledProcessError) as err:
        sys.exit(f"ci-sources: `git ls-files` failed: {err}")
    return [path for path in output.split(b"\0") if path]


def content_hash(path: bytes) -> str:
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(CHUNK_SIZE), b""):
            digest.update(chunk)
    return digest.hexdigest()


def record() -> None:
    files = {}
    for path in tracked_files():
        try:
            files[os.fsdecode(path)] = content_hash(path)
        except OSError:
            # Unreadable or vanished since `ls-files`; leaving it out means
            # `restore` treats it as changed and cargo rebuilds its crate.
            continue

    destination = manifest_path()
    directory = os.path.dirname(destination)
    if directory:
        os.makedirs(directory, exist_ok=True)
    payload = {"version": MANIFEST_VERSION, "mtime": FIXED_MTIME, "files": files}
    temporary = destination + ".tmp"
    with open(temporary, "w", encoding="utf-8") as handle:
        json.dump(payload, handle, sort_keys=True, indent=0)
        handle.write("\n")
    os.replace(temporary, destination)
    print(f"ci-sources: recorded {len(files)} files")


def restore() -> None:
    source = manifest_path()
    try:
        with open(source, encoding="utf-8") as handle:
            payload = json.load(handle)
    except FileNotFoundError:
        print("ci-sources: no manifest, leaving mtimes untouched")
        return
    except (OSError, ValueError) as err:
        print(f"ci-sources: unreadable manifest ({err}), leaving mtimes untouched")
        return

    if payload.get("version") != MANIFEST_VERSION:
        print("ci-sources: manifest version mismatch, leaving mtimes untouched")
        return

    recorded = payload.get("files") or {}
    mtime = payload.get("mtime", FIXED_MTIME)
    unchanged = changed = 0
    for name, expected in recorded.items():
        path = os.fsencode(name)
        try:
            if content_hash(path) != expected:
                changed += 1
                continue
            os.utime(path, (mtime, mtime))
        except OSError:
            changed += 1
            continue
        unchanged += 1
    print(f"ci-sources: rewound {unchanged} files, left {changed} as changed")


def main() -> None:
    if len(sys.argv) != 2 or sys.argv[1] not in ("record", "restore"):
        sys.exit("usage: ci-sources {record|restore}")
    if sys.argv[1] == "record":
        record()
    else:
        restore()


if __name__ == "__main__":
    main()
